generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PARENT
  DRIVER
  ADMIN
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum InstitutionType {
  SCHOOL
  TUITION
  ACTIVITY
}

enum AssignmentStatus {
  REQUESTED
  ACCEPTED
  REJECTED
  CANCELLED
}

enum TripType {
  MORNING
  AFTERNOON
}

enum TripStatus {
  ACTIVE
  ENDED
  CANCELLED
}

enum StopType {
  PICKUP
  DROP
  SCHOOL
}
enum EventType {
  DRIVER_10_MIN_TO_PICKUP
  DRIVER_AT_PICKUP
  CHILD_BOARDED
  DRIVER_AT_SCHOOL
  DRIVER_LEFT_SCHOOL
  DRIVER_10_MIN_TO_DROP
  DRIVER_AT_DROP
  CHILD_DROPPED
}

enum ServiceType {
  SCHOOL
  TUITION
  DANCE
  SPORTS
  OTHER
}

enum ServiceStatus {
  ACTIVE
  ARCHIVED
}

enum ServiceEnrollmentStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

enum SharedRideStatus {
  FORMING
  ACTIVE
  COMPLETED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())
  parentProfile ParentProfile?
  driverProfile DriverProfile?
  deviceTokens DeviceToken[]
}
model ParentProfile {
  userId String @id
  name String
  referralCode String? @unique
  user User @relation(fields:[userId], references:[id])
  children Child[]
  referrerReferrals ParentReferral[] @relation("ReferrerReferrals")
  referredReferrals ParentReferral[] @relation("ReferredReferrals")
  earningsAsReferrer ParentReferralEarnings[] @relation("EarningsAsReferrer")
  earningsAsReferred ParentReferralEarnings[] @relation("EarningsAsReferred")
  serviceEnrollments ServiceEnrollment[]
}
model DriverProfile {
  userId String @id
  name String
  photoUrl String?
  verificationStatus VerificationStatus @default(PENDING)
  licenseDocUrl String?
  vehicleRegDocUrl String?
  idProofUrl String?
  vehiclePhotoUrl String?
  serviceArea String?
  baseLat Float?
  baseLng Float?
  user User @relation(fields:[userId], references:[id])
  vehicle Vehicle?
  institutions DriverInstitution[]
  assignments Assignment[]
  routes RouteTemplate[]
  locationPings LocationPing[]
  services Service[]
  sharedRideGroups SharedRideGroup[]
}
model Vehicle {
  id String @id @default(cuid())
  driverId String @unique
  makeModel String
  plateNumber String?
  seatsCapacity Int
  color String?
  driver DriverProfile @relation(fields:[driverId], references:[userId])
}
model Institution {
  id String @id @default(cuid())
  name String
  type InstitutionType
  address String
  lat Float
  lng Float
  children Child[]
  drivers DriverInstitution[]
  routes RouteTemplate[]
}
model Child {
  id String @id @default(cuid())
  parentId String
  name String
  institutionId String
  pickupAddress String
  pickupLat Float
  pickupLng Float
  dropAddress String
  dropLat Float
  dropLng Float
  emergencyPhone String
  referralCode String?
  parent ParentProfile @relation(fields:[parentId], references:[userId])
  institution Institution @relation(fields:[institutionId], references:[id])
  assignments Assignment[]
  tripStops TripStop[]
  events TripEvent[]
  paymentRecords PaymentRecord[]
  serviceEnrollments ServiceEnrollment[]
}
model DriverInstitution {
  driverId String
  institutionId String
  driver DriverProfile @relation(fields:[driverId], references:[userId])
  institution Institution @relation(fields:[institutionId], references:[id])
  @@id([driverId, institutionId])
}
model Assignment {
  id String @id @default(cuid())
  childId String
  driverId String
  status AssignmentStatus @default(REQUESTED)
  startDate DateTime
  child Child @relation(fields:[childId], references:[id])
  driver DriverProfile @relation(fields:[driverId], references:[userId])
}
model RouteTemplate {
  id String @id @default(cuid())
  driverId String
  institutionId String
  tripType TripType
  driver DriverProfile @relation(fields:[driverId], references:[userId])
  institution Institution @relation(fields:[institutionId], references:[id])
  trips Trip[]
}
model Trip {
  id String @id @default(cuid())
  routeTemplateId String
  date DateTime
  tripType TripType
  status TripStatus @default(ACTIVE)
  startedAt DateTime @default(now())
  endedAt DateTime?
  routeTemplate RouteTemplate @relation(fields:[routeTemplateId], references:[id])
  stops TripStop[]
  events TripEvent[]
  pings LocationPing[]
}
model TripStop {
  id String @id @default(cuid())
  tripId String
  stopType StopType
  childId String?
  lat Float
  lng Float
  address String
  sequenceIndex Int
  trip Trip @relation(fields:[tripId], references:[id])
  child Child? @relation(fields:[childId], references:[id])
}
model TripEvent {
  id String @id @default(cuid())
  tripId String
  childId String
  eventType EventType
  timestamp DateTime @default(now())
  metadata Json?
  trip Trip @relation(fields:[tripId], references:[id])
  child Child @relation(fields:[childId], references:[id])
  @@unique([tripId, childId, eventType])
}
model LocationPing {
  id String @id @default(cuid())
  tripId String?
  driverId String
  lat Float
  lng Float
  timestamp DateTime @default(now())
  trip Trip? @relation(fields:[tripId], references:[id])
  driver DriverProfile @relation(fields:[driverId], references:[userId])
}
model DeviceToken {
  id String @id @default(cuid())
  userId String
  token String @unique
  platform String
  createdAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  user User @relation(fields:[userId], references:[id])
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

model ParentReferral {
  id String @id @default(cuid())
  referrerParentId String
  referredParentId String
  referralCode String @unique
  status String @default("ACTIVE")
  createdAt DateTime @default(now())
  referrerParent ParentProfile @relation("ReferrerReferrals", fields:[referrerParentId], references:[userId])
  referredParent ParentProfile @relation("ReferredReferrals", fields:[referredParentId], references:[userId])
}

model PaymentRecord {
  id String @id @default(cuid())
  childId String
  month Int
  year Int
  amount Int @default(0)
  status PaymentStatus @default(PENDING)
  paidAt DateTime?
  createdAt DateTime @default(now())
  child Child @relation(fields:[childId], references:[id])
  @@unique([childId, month, year])
}

model ParentReferralEarnings {
  id String @id @default(cuid())
  parentId String
  referredParentId String
  referralId String
  amount Int @default(200)
  month Int
  year Int
  status String @default("CREDITED")
  createdAt DateTime @default(now())
  parent ParentProfile @relation("EarningsAsReferrer", fields:[parentId], references:[userId])
  referredParent ParentProfile @relation("EarningsAsReferred", fields:[referredParentId], references:[userId])
  @@unique([referralId, month, year])
}

// Multi-Service Routing Models
model Service {
  id String @id @default(cuid())
  driverId String
  name String
  type ServiceType
  startTime String // HH:MM
  endTime String // HH:MM
  location Json // { lat: number, lng: number }
  daysOfWeek String // JSON array of 0-6
  capacity Int
  pricePerMonth Int
  status ServiceStatus @default(ACTIVE)
  createdAt DateTime @default(now())

  driver DriverProfile @relation(fields:[driverId], references:[userId], onDelete: Cascade)
  enrollments ServiceEnrollment[]
  sharedRideGroups SharedRideGroup[]
}

model ServiceEnrollment {
  id String @id @default(cuid())
  serviceId String
  parentId String
  childId String
  enrollmentType String @default("ALONE") // ALONE, SHARED
  sharedGroupId String?
  pricePerMonth Int
  status ServiceEnrollmentStatus @default(ACTIVE)
  enrolledAt DateTime @default(now())

  service Service @relation(fields:[serviceId], references:[id], onDelete: Cascade)
  parent ParentProfile @relation(fields:[parentId], references:[userId], onDelete: Cascade)
  child Child @relation(fields:[childId], references:[id], onDelete: Cascade)
}

model SharedRideGroup {
  id String @id @default(cuid())
  serviceId String
  driverId String
  parentIds String // JSON array of parent IDs
  childIds String // JSON array of child IDs
  startDate DateTime
  status SharedRideStatus @default(FORMING)
  pricePerParent Int
  seatsUsed Int
  pickupCoords Json? // Array of { lat, lng, address }
  dropCoords Json? // Array of { lat, lng, address }
  createdAt DateTime @default(now())

  service Service @relation(fields:[serviceId], references:[id], onDelete: Cascade)
  driver DriverProfile @relation(fields:[driverId], references:[userId], onDelete: Cascade)
}

